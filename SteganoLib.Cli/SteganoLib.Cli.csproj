<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>SteganoLib.Cli</RootNamespace>
    <AssemblyName>stegano</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>stegano</ToolCommandName>
    <PackageId>SteganoLib.Cli</PackageId>
    <Version>0.1.0</Version>
    <Authors>Piotr Olszewski</Authors>
    <Company>Piotr Olszewski</Company>
    <Description>Command-line front end for SteganoLib: hide and recover authenticated payloads in PNG, JPEG, WAV and text files, measure distortion and run LSB steganalysis.</Description>
    <PackageTags>steganography;cli;dotnet-tool</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/asmie/SteganoLib</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/asmie/SteganoLib</PackageProjectUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SteganoLib\SteganoLib.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SteganoLib.Test" />
  </ItemGroup>

</Project>
