<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>SteganoLib</PackageId>
    <Version>0.1.0</Version>
    <Authors>Piotr Olszewski</Authors>
    <Company>Piotr Olszewski</Company>
    <Description>Steganography for .NET: keyed LSB matching with adaptive selection and syndrome-trellis coding, F5 for JPEG, WAV LSB and phase coding, text and metadata carriers, video frames, an authenticated payload envelope, Reed-Solomon error correction, Shamir secret sharing, steganalysis (chi-square, RS, sample pairs) and distortion metrics.</Description>
    <PackageTags>steganography;steganalysis;lsb;f5;jpeg;wav;image;audio;stc;reed-solomon;shamir</PackageTags>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/asmie/SteganoLib</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/asmie/SteganoLib</PackageProjectUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SteganoLib.Test" />
  </ItemGroup>

</Project>
